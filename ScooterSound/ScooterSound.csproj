<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ScooterSound</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Scooter Sound</ApplicationTitle>
    <ApplicationId>de.scootersound.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#101827" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#101827" BaseSize="128,128" />
    <ProjectReference Include="../ScooterSound.Core/ScooterSound.Core.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers" />
  </ItemGroup>
</Project>
